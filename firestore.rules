rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@osm.local'; }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff';
    }
    function claimOk(d) {
      return d.get('role', '') != 'giocatore'
        || (d.get('pid', '') != ''
            && exists(/databases/$(database)/documents/claims/$(d.pid))
            && get(/databases/$(database)/documents/claims/$(d.pid)).data.uid == request.auth.uid);
    }
    match /{col}/{doc} {
      allow read: if col in ['meta','players','events'];
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && claimOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['u','d'])
        && (resource.data.get('role', '') == ''
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','pid']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','pid'])
            || claimOk(request.resource.data));
    }
    // Un solo utente per giocatore: l'id del documento e' l'id del giocatore.
    // Si puo' creare una sola volta e poi non si puo' piu' modificare (solo l'admin).
    match /claims/{pid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/players/$(pid));
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    match /usernames/{n} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && n == request.resource.data.u.lower();
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }
    match /reads/{id} {
      allow read: if isAdmin() || isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.nid + '_' + request.auth.uid;
      allow delete: if isAdmin() || isStaff();
    }
    match /mvp/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eid + '_' + request.auth.uid;
    }
    match /votes/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eid + '_' + request.auth.uid;
    }
    // ---- LIVE (v1.23) ----
    // Lo stato della partita live lo scrivono solo admin e staff; lo leggono tutti.
    match /live/{eid} {
      allow read: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }
    // Segnalazione WebRTC per la ripresa video: solo utenti registrati.
    // Il documento "_bc" (stato della ripresa) lo scrive solo staff/admin;
    // ogni spettatore scrive solo il proprio documento (id = suo uid).
    match /live/{eid}/rtc/{vid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && (request.auth.uid == vid || isAdmin() || isStaff());
    }
    // Lo staff puo' aggiornare SOLO le statistiche di una partita
    // (gol, assist, cartellini, minuti giocati calcolati dal live).
    match /events/{id} {
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']);
    }
  }
}
